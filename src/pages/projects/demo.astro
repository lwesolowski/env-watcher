---
import Layout from "../../layouts/Layout.astro";
import { ProjectEditor } from "../../components/ProjectEditor";
import { ReportTable } from "../../components/ReportTable";
import { RecommendationsSection } from "../../components/RecommendationsSection";
import { UseAsTemplateButton } from "../../components/UseAsTemplateButton";
import { Badge } from "../../components/ui/badge";

const demoData = {
  name: "DEMO Project",
  develop_config: "node: 18.1.0\npostgres: 14.1\nredis: 6.2\nstripe_api_version: 2022-11-15",
  staging_config: "node: 18.1.0\npostgres: 14.1\nredis: 6.2\nstripe_api_version: 2022-11-15",
  production_config: "node: 16.15.0\npostgres: 12.8\nredis: 6.0\nstripe_api_version: 2020-08-27",
};

const demoReport = `
<table>
  <thead>
    <tr>
      <th>Feature</th>
      <th>Develop</th>
      <th>Staging</th>
      <th>Production</th>
      <th>Source Fragment</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Node.js</td>
      <td>18.1.0</td>
      <td>18.1.0</td>
      <td style="color: red;">16.15.0</td>
      <td>"node: 16.15.0"</td>
    </tr>
    <tr>
      <td>PostgreSQL</td>
      <td>14.1</td>
      <td>14.1</td>
      <td style="color: red;">12.8</td>
      <td>"postgres: 12.8"</td>
    </tr>
    <tr>
      <td>Stripe API</td>
      <td>2022-11-15</td>
      <td>2022-11-15</td>
      <td style="color: red;">2020-08-27</td>
      <td>"stripe_api_version: 2020-08-27"</td>
    </tr>
  </tbody>
</table>
`;

const demoRecommendations = [
  { priority: "high", text: "Production Node.js version (16.15.0) is outdated and differs from Develop/Staging. Update to 18.1.0 to avoid compatibility issues." },
  { priority: "medium", text: "PostgreSQL 12.8 in Production is several major versions behind. Plan an upgrade to 14.1 to match environments." },
  { priority: "low", text: "Environments are consistent between Develop and Staging. Good job!" },
];
---

<Layout title="Demo Project - EnvWatcher">
  <div class="py-8 space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">{demoData.name}</h1>
          <Badge variant="outline" class="bg-yellow-500/10 text-yellow-500 border-yellow-500/20">DEMO MODE</Badge>
        </div>
        <p class="text-muted-foreground mt-1">This is a read-only preview of a project analysis.</p>
      </div>
      <div class="flex gap-2">
        <UseAsTemplateButton client:load />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 opacity-60 pointer-events-none">
      {['Develop', 'Staging', 'Production'].map((env) => (
        <div class="rounded-xl border bg-card text-card-foreground shadow-sm p-6">
          <h3 class="text-sm font-medium mb-3">{env} Environment</h3>
          <pre class="text-xs font-mono bg-muted p-3 rounded h-32 overflow-hidden">{demoData[`${env.toLowerCase()}_config` as keyof typeof demoData]}</pre>
        </div>
      ))}
    </div>

    <div class="space-y-6">
      <ReportTable htmlContent={demoReport} />
      <RecommendationsSection recommendations={demoRecommendations} />
    </div>
  </div>
</Layout>
