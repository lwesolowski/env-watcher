---
import Layout from "../../layouts/Layout.astro";
import { ProjectEditor } from "../../components/ProjectEditor";
import { $user } from "../../lib/authStore";

const user = $user.get();
---

<Layout title="New Project - EnvWatcher">
  <div class="container py-8">
    {user ? (
      <ProjectEditor userId={user.id} client:load />
    ) : (
      <div class="text-center py-12">
        <h2 class="text-2xl font-bold">Authentication required</h2>
        <p class="text-muted-foreground mt-2">Please login to create a project.</p>
        <a href="/login" class="mt-4 inline-block text-primary hover:underline">Go to Login</a>
      </div>
    )}
  </div>
</Layout>
