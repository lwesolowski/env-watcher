---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <script is:inline>
    // Simple redirect for MVP.
    const hasSession = !!localStorage.getItem('sb-token'); // Simple heuristic
    if (!hasSession) {
      window.location.href = '/login';
    } else {
      window.location.href = '/dashboard';
    }
  </script>
</Layout>
